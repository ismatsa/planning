# Copier ce fichier en .env dans le dossier privé app/ sur o2switch.
# Renseigner les identifiants MySQL créés dans cPanel.
DB_HOST=localhost
DB_NAME=utilisateur_cpanel_booking
DB_USER=utilisateur_cpanel_booking
DB_PASS=remplacer_par_le_mot_de_passe_mysql

# API SYNC (machine-à-machine, localhost uniquement). Clé de 32 caractères minimum.
# Générer : php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
SYNC_API_KEY=
# IP supplémentaires autorisées (optionnel, séparées par des virgules)
SYNC_ALLOWED_IPS=
